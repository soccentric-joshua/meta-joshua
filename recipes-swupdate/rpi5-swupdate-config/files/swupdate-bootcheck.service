[Unit]
Description=SWUpdate boot health check — confirm OTA slot or trigger rollback
Documentation=https://sbabic.github.io/swupdate/
After=network-online.target acadia-client.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/swupdate/swupdate-bootcheck.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
